  args = --filter ...  --filter FlattenComponentsFilter --filter $
      DecomposeTransformedComponentsFilter
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
# Generating instance_ufos/Arimo-Regular.ufo.json
build instance_ufos/Arimo-Regular.ufo.json: instantiateUfo Arimo.designspace
  operation = instantiateUfo
  instance_name = Arimo Regular
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
  args =  --ufo-structure=json --output-dir instance_ufos
# Generating instance_ufos/Arimo-Bold.ufo.json
