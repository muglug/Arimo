  operation = instantiateUfo
  instance_name = Arimo Bold
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
  args =  --ufo-structure=json --output-dir instance_ufos
# Generating ../fonts/webfonts/Arimo-Italic[wght].woff2
build ../fonts/webfonts/Arimo-Italic[wght].woff2: compress $
    ../fonts/variable/Arimo-Italic[wght].ttf
  operation = compress
# Postprocessing  with BuildSTAT
build $
    /var/folders/ys/kzhbdm0s7b54fg_2jkfqdb500000gn/T/tmpv0kti1xw.buildStatstamp: $
    buildSTAT-postprocess ../fonts/variable/Arimo-Italic[wght].ttf $
    ../fonts/variable/Arimo[wght].ttf | $
    ../fonts/variable/Arimo-Italic[wght].ttf ../fonts/variable/Arimo[wght].ttf
  stamp =  && touch $
      /var/folders/ys/kzhbdm0s7b54fg_2jkfqdb500000gn/T/tmpv0kti1xw.buildStatstamp
  postprocess = buildStat
# Generating ../fonts/webfonts/Arimo[wght].woff2
build ../fonts/webfonts/Arimo[wght].woff2: compress $
    ../fonts/variable/Arimo[wght].ttf
  operation = compress
