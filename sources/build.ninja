    ../fonts/variable/Arimo-Italic[wght].ttf
  operation = compress
# Postprocessing  with BuildSTAT
build $
    /var/folders/ys/kzhbdm0s7b54fg_2jkfqdb500000gn/T/tmpmo2amc_y.buildStatstamp: $
    buildSTAT-postprocess ../fonts/variable/Arimo[wght].ttf $
    ../fonts/variable/Arimo-Italic[wght].ttf | $
    ../fonts/variable/Arimo[wght].ttf ../fonts/variable/Arimo-Italic[wght].ttf
  stamp =  && touch $
      /var/folders/ys/kzhbdm0s7b54fg_2jkfqdb500000gn/T/tmpmo2amc_y.buildStatstamp
  postprocess = buildStat
# Generating ../fonts/webfonts/Arimo[wght].woff2
build ../fonts/webfonts/Arimo[wght].woff2: compress $
    ../fonts/variable/Arimo[wght].ttf
